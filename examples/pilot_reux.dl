module pilot

entity Account {
  id: Id<Account> primary generated
  email: String unique
  displayName: String?
  balance: Decimal<12,2> default 0
  createdAt: Instant default now()

  index byEmail(email asc)
}

entity Product {
  id: Id<Product> primary generated
  sku: String unique
  name: String
  price: Decimal<12,2> check price >= 0
  currency: CurrencyCode default USD
}

entity Order {
  id: Id<Order> primary generated
  account: Account required
  total: Decimal<12,2> check total >= 0
  currency: CurrencyCode default USD
  status: OrderStatus default Pending
  placedAt: Instant default now()

  index byAccount(account asc)
}

entity Payment {
  id: Id<Payment> primary generated
  order: Order required
  amount: Decimal<12,2> check amount >= 0
  currency: CurrencyCode default USD
  status: PaymentStatus default Authorized
  capturedAt: Instant?

  index byOrder(order asc)
}

enum OrderStatus {
  Pending
  Paid
  Cancelled
  Refunded
}

enum PaymentStatus {
  Authorized
  Captured
  Failed
  Refunded
}

transition Order.status {
  Pending -> Paid
  Pending -> Cancelled
  Paid -> Refunded
}

transition Payment.status {
  Authorized -> Captured
  Authorized -> Failed
  Captured -> Refunded
}

query openOrders(minTotal: Decimal<12,2>): Query<{ total: Decimal<12,2>, status: OrderStatus }> =
  from order in Order
  where order.total > minTotal
  order by order.total desc
  select { total: order.total, status: order.status }

query accountBalances(min: Decimal<12,2>): Query<{ email: String, balance: Decimal<12,2> }> =
  from account in Account
  where account.balance > min
  order by account.balance desc
  select { email: account.email, balance: account.balance }

query accountOrders(minTotal: Decimal<12,2>): Query<{ email: String, total: Decimal<12,2>, status: OrderStatus }> =
  from order in Order
  join account in Account on order.account == account
  where order.total > minTotal
  order by order.total desc
  select { email: account.email, total: order.total, status: order.status }

query orderPayments(minAmount: Decimal<12,2>): Query<{ total: Decimal<12,2>, paymentAmount: Decimal<12,2>, paymentStatus: PaymentStatus }> =
  from payment in Payment
  join order in Order on payment.order == order
  where payment.amount > minAmount
  order by payment.amount desc
  select { total: order.total, paymentAmount: payment.amount, paymentStatus: payment.status }

query accountOrderSummary(minTotal: Decimal<12,2>): Query<{ email: String, orderCount: Int64, totalSpend: Decimal<12,2> }> =
  from order in Order
  join account in Account on order.account == account
  where order.total > minTotal
  group by account.email
  order by sum(order.total) desc
  select { email: account.email, orderCount: count(), totalSpend: sum(order.total) }

transaction function capturePayment(orderRef: Order, amount: Decimal<12,2>) writes Payment retry 3 {
  let order = load orderRef for update
  let payment = insert Payment { order: orderRef, amount: amount, currency: order.currency, status: Captured }
  enqueue PaymentCaptured { payment: payment.id, order: orderRef, amount: amount, currency: order.currency }
  after commit sendReceipt(orderRef)
}

transaction function markOrderPaid(orderRef: Order) writes Order retry 3 {
  let order = load orderRef for update
  order.status = Paid
  save order
  enqueue OrderPaid { order: orderRef }
  after commit notifyOrderPaid(orderRef)
}

transaction function creditAccount(accountRef: Account, amount: Decimal<12,2>) writes Account retry 3 {
  let account = load accountRef for update
  account.balance += amount
  save account
  enqueue AccountCredited { account: accountRef, amount: amount }
  after commit notifyAccountCredited(accountRef)
}
