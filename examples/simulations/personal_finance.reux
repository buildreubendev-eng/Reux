module personal_life

simulate personal_finance {
  income = 5000
  rent = 1500
  debt_payment = 500
  formula cash_flow = income - rent - debt_payment
  formula annual_surplus = cash_flow * 12

  scenario lower_rent {
    rent = 1200
  }

  scenario debt_free {
    debt_payment = 0
  }

  forecast 12 months
}
