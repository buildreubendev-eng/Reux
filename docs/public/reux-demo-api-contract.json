{
  "project": "Reux",
  "contract": "public-demo-api",
  "version": "2026-05-02",
  "baseUrlEnv": "NEXT_PUBLIC_REUX_DEMO_URL",
  "defaultBaseUrl": "https://reux-pilot-demo-production.up.railway.app",
  "responseHeaders": [
    {
      "name": "cache-control",
      "value": "no-store",
      "purpose": "Prevent stale public demo API responses from being cached."
    },
    {
      "name": "x-reux-api-version",
      "value": "2026-05-02",
      "purpose": "Identify the public demo API contract version served by the deployment."
    },
    {
      "name": "x-reux-build",
      "value": "short build or commit identifier",
      "purpose": "Identify which deployed backend build handled the request."
    },
    {
      "name": "retry-after",
      "value": "seconds until retry is allowed",
      "purpose": "Tell clients when to retry after a 429 rate_limited response."
    }
  ],
  "headers": [
    {
      "name": "content-type",
      "requiredFor": ["POST"],
      "value": "application/json"
    },
    {
      "name": "x-reux-demo-session",
      "requiredFor": ["visitor isolation"],
      "value": "stable browser session id, 8-16 normalized alphanumeric characters"
    },
    {
      "name": "x-reux-demo-token",
      "requiredFor": ["admin setup routes when REUX_DEMO_SETUP_TOKEN is set"],
      "value": "private deployment token"
    }
  ],
  "limits": {
    "jsonBodyLimitBytesDefault": 65536,
    "rateLimitWindowMsDefault": 60000,
    "rateLimitMaxRequestsDefault": 240,
    "writeRateLimitMaxRequestsDefault": 60,
    "maxSessionContextsDefault": 100,
    "sessionIdleMsDefault": 1800000,
    "maxSimulationRunRecordsDefault": 200,
    "simulationRunTtlMsDefault": 86400000,
    "businessSimulatorMaxRunScenarios": 8,
    "businessSimulatorMaxCompareScenarios": 12,
    "businessSimulatorMaxForecastPeriods": 52,
    "businessSimulatorMaxEmployees": 10000,
    "businessSimulatorMaxWeeklyDemand": 1000000,
    "businessSimulatorMaxAverageHourlyCost": 1000,
    "businessSimulatorMaxAverageOrderValue": 1000000
  },
  "businessSimulatorAssumptionFields": [
    {
      "name": "employees",
      "label": "Employees",
      "group": "team",
      "inputKind": "integer",
      "unit": "count",
      "min": 1,
      "max": 10000,
      "step": 1,
      "baselineEditable": true,
      "scenarioEditable": true
    },
    {
      "name": "averageHourlyCost",
      "label": "Average hourly cost",
      "group": "team",
      "inputKind": "money",
      "unit": "USD",
      "min": 0.01,
      "max": 1000,
      "step": 1,
      "baselineEditable": true,
      "scenarioEditable": true
    },
    {
      "name": "weeklyDemand",
      "label": "Weekly demand",
      "group": "demand",
      "inputKind": "number",
      "unit": "orders",
      "min": 0,
      "max": 1000000,
      "step": 1,
      "baselineEditable": true,
      "scenarioEditable": true
    },
    {
      "name": "averageOrderValue",
      "label": "Average order value",
      "group": "demand",
      "inputKind": "money",
      "unit": "USD",
      "min": 0.01,
      "max": 1000000,
      "step": 1,
      "baselineEditable": true,
      "scenarioEditable": true
    },
    {
      "name": "grossMarginRate",
      "label": "Gross margin rate",
      "group": "margin",
      "inputKind": "rate",
      "unit": "percent",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "display": {
        "scale": 100,
        "suffix": "%"
      },
      "baselineEditable": true,
      "scenarioEditable": true
    },
    {
      "name": "productivityGainRate",
      "label": "Productivity gain",
      "group": "margin",
      "inputKind": "rate",
      "unit": "percent",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "display": {
        "scale": 100,
        "suffix": "%"
      },
      "baselineEditable": true,
      "scenarioEditable": true
    },
    {
      "name": "overtimeReductionRate",
      "label": "Overtime reduction",
      "group": "team",
      "inputKind": "rate",
      "unit": "percent",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "display": {
        "scale": 100,
        "suffix": "%"
      },
      "baselineEditable": true,
      "scenarioEditable": true
    },
    {
      "name": "supplierDelayRiskRate",
      "label": "Supplier delay risk",
      "group": "risk",
      "inputKind": "rate",
      "unit": "percent",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "display": {
        "scale": 100,
        "suffix": "%"
      },
      "baselineEditable": true,
      "scenarioEditable": true
    },
    {
      "name": "defectRate",
      "label": "Defect rate",
      "group": "risk",
      "inputKind": "rate",
      "unit": "percent",
      "min": 0,
      "max": 1,
      "step": 0.001,
      "display": {
        "scale": 100,
        "suffix": "%"
      },
      "baselineEditable": true,
      "scenarioEditable": true
    },
    {
      "name": "forecastPeriods",
      "label": "Forecast periods",
      "group": "forecast",
      "inputKind": "integer",
      "unit": "periods",
      "min": 1,
      "max": 52,
      "step": 1,
      "baselineEditable": true,
      "scenarioEditable": false
    },
    {
      "name": "forecastUnit",
      "label": "Forecast unit",
      "group": "forecast",
      "inputKind": "select",
      "options": ["week", "month", "quarter"],
      "baselineEditable": true,
      "scenarioEditable": false
    }
  ],
  "errorCodes": [
    "business_simulator_validation_failed",
    "simulation_execution_validation_failed",
    "pilot_request_validation_failed",
    "invalid_json",
    "request_too_large",
    "rate_limited",
    "not_found",
    "saved_run_expired",
    "method_not_allowed",
    "request_failed"
  ],
  "errorExamples": [
    {
      "name": "invalidBusinessSimulatorField",
      "status": 400,
      "code": "business_simulator_validation_failed",
      "body": {
        "ok": false,
        "error": "$.baseline.grossMarginRate: must be between 0 and 1",
        "message": "$.baseline.grossMarginRate: must be between 0 and 1",
        "code": "business_simulator_validation_failed",
        "category": "validation",
        "retryable": false,
        "userAction": "Fix the request fields and try again.",
        "issues": [
          {
            "path": "$.baseline.grossMarginRate",
            "message": "must be between 0 and 1"
          }
        ]
      }
    },
    {
      "name": "tooManyBusinessSimulatorScenarios",
      "status": 400,
      "code": "business_simulator_validation_failed",
      "body": {
        "ok": false,
        "error": "$.scenarios: must contain 8 or fewer scenarios",
        "message": "$.scenarios: must contain 8 or fewer scenarios",
        "code": "business_simulator_validation_failed",
        "category": "validation",
        "retryable": false,
        "userAction": "Fix the request fields and try again.",
        "issues": [
          {
            "path": "$.scenarios",
            "message": "must contain 8 or fewer scenarios"
          }
        ]
      }
    },
    {
      "name": "invalidReuxSimulationUnit",
      "status": 400,
      "code": "simulation_execution_validation_failed",
      "body": {
        "ok": false,
        "error": "$.assumptions.income: must preserve declared unit USD",
        "message": "$.assumptions.income: must preserve declared unit USD",
        "code": "simulation_execution_validation_failed",
        "category": "validation",
        "retryable": false,
        "userAction": "Fix the request fields and try again.",
        "issues": [
          {
            "path": "$.assumptions.income",
            "message": "must preserve declared unit USD"
          }
        ]
      }
    },
    {
      "name": "expiredBusinessSimulatorRun",
      "status": 410,
      "code": "saved_run_expired",
      "body": {
        "ok": false,
        "error": "simulation run 'live_4f6c9f1a20b3448d' expired at 2026-05-03T00:00:00.000Z",
        "message": "simulation run 'live_4f6c9f1a20b3448d' expired at 2026-05-03T00:00:00.000Z",
        "code": "saved_run_expired",
        "category": "expired",
        "retryable": false,
        "userAction": "Start a new simulation run.",
        "expiresAt": "2026-05-03T00:00:00.000Z"
      }
    },
    {
      "name": "missingBusinessSimulatorRun",
      "status": 404,
      "code": "not_found",
      "body": {
        "ok": false,
        "error": "simulation run 'live_missing' was not found",
        "message": "simulation run 'live_missing' was not found",
        "code": "not_found",
        "category": "not_found",
        "retryable": false,
        "userAction": "Check the link or create a new result."
      }
    },
    {
      "name": "rateLimited",
      "status": 429,
      "code": "rate_limited",
      "body": {
        "ok": false,
        "error": "too many requests; please wait before trying again",
        "message": "too many requests; please wait before trying again",
        "code": "rate_limited",
        "category": "rate_limit",
        "retryable": true,
        "userAction": "Wait until the retry window opens, then try again.",
        "limit": 10,
        "remaining": 0,
        "resetAt": "2026-05-03T00:01:00.000Z",
        "retryAfterSeconds": 30,
        "windowMs": 60000
      }
    }
  ],
  "routes": [
    {
      "name": "health",
      "method": "GET",
      "path": "/api/health",
      "auth": "public",
      "session": "none",
      "purpose": "Read deployment health, active domains, body limit, rate-limit settings, request counters, session-cache counters, saved simulation-run storage stats, and pilot-request delivery status."
    },
    {
      "name": "operationsDashboard",
      "method": "GET",
      "path": "/api/ops",
      "auth": "public",
      "session": "optional isolated visitor session",
      "purpose": "Read cross-domain queue health for lightweight operations checks."
    },
    {
      "name": "listBusinessSimulations",
      "method": "GET",
      "path": "/api/simulations",
      "auth": "public",
      "session": "none",
      "purpose": "List Business Simulator templates for website clients."
    },
    {
      "name": "getBusinessSimulation",
      "method": "GET",
      "path": "/api/simulations/operations-decision",
      "auth": "public",
      "session": "none",
      "purpose": "Load the current operations-decision template, defaults, assumption field metadata, and starter scenarios."
    },
    {
      "name": "getCapacityPlanningSimulation",
      "method": "GET",
      "path": "/api/simulations/capacity-planning",
      "auth": "public",
      "session": "none",
      "purpose": "Load the capacity-planning template, defaults, assumption field metadata, and starter scenarios."
    },
    {
      "name": "getStaffingPlanSimulation",
      "method": "GET",
      "path": "/api/simulations/staffing-plan",
      "auth": "public",
      "session": "none",
      "purpose": "Load the staffing-plan template, defaults, assumption field metadata, and starter scenarios."
    },
    {
      "name": "getPricingStrategySimulation",
      "method": "GET",
      "path": "/api/simulations/pricing-strategy",
      "auth": "public",
      "session": "none",
      "purpose": "Load the pricing-strategy template, defaults, assumption field metadata, and starter scenarios."
    },
    {
      "name": "runBusinessSimulation",
      "method": "POST",
      "path": "/api/simulations/run",
      "auth": "public",
      "session": "optional isolated visitor session",
      "purpose": "Run a baseline plus scenarios, save a temporary run record, and return metrics, forecast timeline, frontend-ready recommendation summaries, optional Reux source, and run metadata with postgres or memory storage status."
    },
    {
      "name": "listBusinessSimulationRuns",
      "method": "GET",
      "path": "/api/simulation-runs",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "List recent saved Business Simulator run summaries for the caller's session, including persistence storage status."
    },
    {
      "name": "getBusinessSimulationRun",
      "method": "GET",
      "path": "/api/simulation-runs/:id",
      "auth": "public",
      "session": "shareable run id",
      "purpose": "Load one saved Business Simulator run by ID for result pages or sharing, including persistence storage status."
    },
    {
      "name": "compareBusinessScenarios",
      "method": "POST",
      "path": "/api/scenarios/compare",
      "auth": "public",
      "session": "none",
      "purpose": "Compare already-run Business Simulator scenario results."
    },
    {
      "name": "createPilotRequest",
      "method": "POST",
      "path": "/api/pilot-requests",
      "auth": "public",
      "session": "none",
      "purpose": "Accept and store a Founder Pilot request, then send it through Resend when delivery is configured."
    },
    {
      "name": "listPilotRequests",
      "method": "GET",
      "path": "/api/pilot-requests",
      "auth": "x-reux-demo-token when configured",
      "session": "operator",
      "purpose": "List stored Founder Pilot requests for the operator lead view."
    },
    {
      "name": "getPilotRequest",
      "method": "GET",
      "path": "/api/pilot-requests/:id",
      "auth": "x-reux-demo-token when configured",
      "session": "operator",
      "purpose": "Load one stored Founder Pilot request including contact, decision, source, delivery, and storage metadata."
    },
    {
      "name": "listReuxSimulations",
      "method": "GET",
      "path": "/api/reux/simulations",
      "auth": "public",
      "session": "none",
      "purpose": "List executable Reux simulation examples with dimensions, assumptions, metrics, objectives, and source file names."
    },
    {
      "name": "getReuxSimulation",
      "method": "GET",
      "path": "/api/reux/simulations/:name",
      "auth": "public",
      "session": "none",
      "purpose": "Load one Reux simulation model by name."
    },
    {
      "name": "runReuxSimulation",
      "method": "POST",
      "path": "/api/reux/simulations/:name/run",
      "auth": "public",
      "session": "none",
      "purpose": "Execute one Reux simulation with optional runtime baseline assumptions and runtime scenarios."
    },
    {
      "name": "commerceDashboard",
      "method": "GET",
      "path": "/api/dashboard",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "Read commerce demo state, queue health, and setup-required status."
    },
    {
      "name": "commerceResetSession",
      "method": "POST",
      "path": "/api/session/reset",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "Create/reset the caller's commerce seed data without requiring the admin token."
    },
    {
      "name": "commerceSetup",
      "method": "POST",
      "path": "/api/setup",
      "auth": "admin token when configured",
      "session": "shared or isolated session",
      "purpose": "Apply schema and reset commerce seed data for admin setup flows."
    },
    {
      "name": "commerceCapturePayment",
      "method": "POST",
      "path": "/api/actions/capture-payment",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "Run the commerce payment-capture transaction."
    },
    {
      "name": "commerceMarkPaid",
      "method": "POST",
      "path": "/api/actions/mark-paid",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "Run the commerce order-paid transaction."
    },
    {
      "name": "commerceCreditAccount",
      "method": "POST",
      "path": "/api/actions/credit-account",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "Run the commerce account-credit transaction."
    },
    {
      "name": "commerceProcessOutbox",
      "method": "POST",
      "path": "/api/outbox/process",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "Process pending commerce outbox events for the caller's session."
    },
    {
      "name": "commerceOutboxStats",
      "method": "GET",
      "path": "/api/outbox/stats",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "Read commerce outbox totals grouped by status."
    },
    {
      "name": "logisticsDashboard",
      "method": "GET",
      "path": "/api/logistics/dashboard",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "Read logistics demo state, queue health, and setup-required status."
    },
    {
      "name": "logisticsResetSession",
      "method": "POST",
      "path": "/api/logistics/session/reset",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "Create/reset the caller's logistics seed data without requiring the admin token."
    },
    {
      "name": "logisticsSetup",
      "method": "POST",
      "path": "/api/logistics/setup",
      "auth": "admin token when configured",
      "session": "shared or isolated session",
      "purpose": "Apply schema and reset logistics seed data for admin setup flows."
    },
    {
      "name": "logisticsStartShipment",
      "method": "POST",
      "path": "/api/logistics/actions/start-shipment",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "Run the logistics shipment-start transaction."
    },
    {
      "name": "logisticsMarkDelivered",
      "method": "POST",
      "path": "/api/logistics/actions/mark-delivered",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "Run the logistics delivered transaction."
    },
    {
      "name": "logisticsCreditDriver",
      "method": "POST",
      "path": "/api/logistics/actions/credit-driver",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "Run the logistics driver-credit transaction."
    },
    {
      "name": "logisticsProcessOutbox",
      "method": "POST",
      "path": "/api/logistics/outbox/process",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "Process pending logistics outbox events for the caller's session."
    },
    {
      "name": "logisticsOutboxStats",
      "method": "GET",
      "path": "/api/logistics/outbox/stats",
      "auth": "public",
      "session": "isolated visitor session",
      "purpose": "Read logistics outbox totals grouped by status."
    }
  ]
}
